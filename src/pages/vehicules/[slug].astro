---
import Base from '../../layouts/Base.astro';
import PhotoVehicule from '../../components/PhotoVehicule.astro';
import { SITE } from '../../data/site';
import { VEHICULES, titre, fmtPrix, AC, type Vehicule } from '../../data/vehicules';

export function getStaticPaths() {
  return VEHICULES.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}
interface Props { v: Vehicule }
const { v } = Astro.props;
const nom = titre(v);
const prix = fmtPrix(v);
const sms = `sms:${SITE.telLien}?&body=${encodeURIComponent(`Bonjour, je suis intéressé(e) par la ${nom} vue sur votre site. Est-elle toujours disponible ?`)}`;
const nf = new Intl.NumberFormat('fr-FR');
const cases: [string, string | null][] = [
  ['Marque', v.marque], ['Modèle', v.modele], ['Version', v.version],
  ['Année', v.annee ? String(v.annee) : null], ['Kilométrage', v.km == null ? null : `${nf.format(v.km)} km`],
  ['Carburant', v.carburant], ['Boîte', v.boite], ['Puissance', v.puissance],
];
const statutTxt = { disponible: 'Disponible', réservé: 'Réservé', vendu: 'Vendu' }[v.statut];
const autres = VEHICULES.filter((x) => x.slug !== v.slug && x.statut !== 'vendu').slice(0, 2);
const photos = v.photos.length ? v.photos.map((_, i) => i) : [0];

const car: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Car',
  name: nom,
  brand: { '@type': 'Brand', name: v.marque },
  model: v.modele,
  itemCondition: 'https://schema.org/UsedCondition',
  url: new URL(`/vehicules/${v.slug}/`, Astro.site).href,
};
if (v.version) car.vehicleConfiguration = v.version;
if (v.annee) car.vehicleModelDate = String(v.annee);
if (v.km != null) car.mileageFromOdometer = { '@type': 'QuantitativeValue', value: v.km, unitCode: 'KMT' };
if (v.carburant) car.fuelType = v.carburant;
if (v.boite) car.vehicleTransmission = v.boite;
if (v.prix != null) {
  car.offers = {
    '@type': 'Offer',
    price: v.prix,
    priceCurrency: 'EUR',
    availability: v.statut === 'disponible' ? 'https://schema.org/InStock' : v.statut === 'réservé' ? 'https://schema.org/LimitedAvailability' : 'https://schema.org/SoldOut',
    seller: { '@id': new URL('/#garage', Astro.site).href },
  };
}
const desc = `${nom} d'occasion à vendre chez MON AUTO, 37 route de Calais à Groslay (95). Année, kilométrage, carburant, boîte et prix. Appelez le ${SITE.telAffiche}.`;
---
<Base title={`${nom} d'occasion à Groslay | MON AUTO`} description={desc} jsonld={[car]}>
  <article class="wrap pt-8 pb-16 md:pt-12 md:pb-24">
    <nav aria-label="Fil d'Ariane" class="text-[0.9rem] text-encre-2 mb-6">
      <a href="/" class="underline underline-offset-4">Accueil</a> / <a href="/vehicules/" class="underline underline-offset-4">Nos véhicules</a> / {nom}
    </nav>

    <div class="grid gap-8 lg:grid-cols-[1.25fr_1fr] lg:gap-12 items-start">
      <div class="space-y-4">
        {photos.map((i) => (
          <div class="border-2 border-encre rounded-[3px] overflow-hidden">
            <PhotoVehicule v={v} index={i} eager={i === 0} legende={i === 0 ? 'Photo à prendre : la voiture de 3/4 avant, devant le garage, en lumière du jour. Puis 3/4 arrière, intérieur, compteur.' : undefined} />
          </div>
        ))}
      </div>

      <div class="fiche-detail bg-papier border-2 border-encre rounded-[3px]">
        <div class="flex items-center justify-between gap-3 border-b-2 border-encre px-5 py-2.5 text-[0.9rem]">
          <span class="font-titre font-semibold">Carnet du véhicule</span>
          <span class="font-semibold">{statutTxt}</span>
        </div>
        <div class="p-5 md:p-7">
          {v.exemple && <p class="ac inline-block mb-3">{v.exemple}</p>}
          <h1 class="text-[2.2rem] md:text-[2.8rem]">{nom}</h1>
          <p class="mt-5 leading-none">
            <span class="block text-[0.9rem] text-encre-2 mb-2">Prix</span>
            {prix ? <span class="font-titre font-bold text-[3.4rem] tracking-[-0.04em]">{prix}</span> : <span class="ac text-[1.1rem]">Prix {AC}</span>}
          </p>
          <dl class="cases mt-6 grid grid-cols-2 border-t border-l border-regle">
            {cases.map(([k, x]) => <div><dt>{k}</dt><dd>{x ?? <span class="ac">{AC}</span>}</dd></div>)}
          </dl>
          {v.description && <p class="mt-6">{v.description}</p>}
          <div class="mt-7 grid gap-3 sm:grid-cols-2">
            <a href={`tel:${SITE.telLien}`} class="btn btn-plein">Je suis intéressé</a>
            <a href={sms} class="btn btn-ligne">Envoyer un SMS</a>
          </div>
          <p class="mt-4 text-[0.92rem] text-encre-2">Le SMS s'ouvre prêt à envoyer avec le nom de la voiture. Visite et essai au {SITE.adresse.rue}, {SITE.adresse.ville}.</p>
          <span class="tampon mt-6">CONTRÔLÉ</span>
        </div>
      </div>
    </div>

    {autres.length > 0 && (
      <aside class="mt-16" aria-labelledby="t-autres">
        <h2 id="t-autres" class="text-[1.6rem] md:text-[2rem] mb-5">Aussi au garage</h2>
        <ul class="grid gap-3 sm:grid-cols-2 max-w-3xl">
          {autres.map((a) => (
            <li><a href={`/vehicules/${a.slug}/`} class="flex items-center justify-between gap-3 bg-papier border-2 border-encre px-4 py-4 no-underline font-titre font-semibold hover:bg-sable-fonce min-h-[56px]">{titre(a)}<span aria-hidden="true">›</span></a></li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</Base>

<style>
  .cases > div { border-right: 1px solid var(--color-regle); border-bottom: 1px solid var(--color-regle); padding: .6rem .75rem; min-width: 0; }
  .cases dt { font-size: .8rem; color: var(--color-encre-2); }
  .cases dd { font-family: var(--font-titre); font-weight: 600; overflow-wrap: anywhere; }
</style>
