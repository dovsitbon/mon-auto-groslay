---
import { SITE } from '../data/site';
---
<div class="carte relative min-w-0 w-full aspect-[4/3] md:aspect-auto md:h-full min-h-[280px] border-2 border-encre rounded-[3px] overflow-hidden bg-sable-fonce" data-carte>
  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width="400" height="300" fill="#e3d6bf" />
    <path d="M-10 250 C 90 210, 160 170, 230 120 S 360 30, 420 10" stroke="#fbf7ef" stroke-width="22" fill="none" />
    <path d="M-10 250 C 90 210, 160 170, 230 120 S 360 30, 420 10" stroke="#cbbb9f" stroke-width="2" stroke-dasharray="10 9" fill="none" />
    <path d="M60 -10 L 140 320" stroke="#fbf7ef" stroke-width="9" fill="none" />
    <path d="M300 320 L 250 -10" stroke="#fbf7ef" stroke-width="7" fill="none" />
    <text x="250" y="150" font-family="Public Sans Variable, sans-serif" font-size="13" fill="#4a5468" transform="rotate(-33 250 150)">route de Calais</text>
    <circle cx="205" cy="138" r="13" fill="#15233f" /><circle cx="205" cy="138" r="5" fill="#fbf7ef" />
  </svg>
  <div class="absolute left-3 right-3 bottom-3 flex flex-wrap gap-2">
    <button type="button" class="btn btn-plein" data-charger-carte>Afficher la carte Google</button>
    <a href={SITE.itineraire} class="btn btn-ligne bg-papier" target="_blank" rel="noopener">Itinéraire</a>
  </div>
  <p class="absolute left-3 top-3 bg-papier px-2.5 py-1 text-[0.85rem] border border-encre">{SITE.adresse.rue}, {SITE.adresse.cp} {SITE.adresse.ville}</p>
</div>
<script>
  import { SITE } from '../data/site';
  document.querySelectorAll<HTMLElement>('[data-carte]').forEach((box) => {
    box.querySelector('[data-charger-carte]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = SITE.carte;
      f.title = 'Carte : MON AUTO, 37 route de Calais, Groslay';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.className = 'absolute inset-0 w-full h-full border-0';
      box.replaceChildren(f);
      f.focus();
    });
  });
</script>
