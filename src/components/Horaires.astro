---
import { HORAIRES, fmtHeure } from '../data/site';
---
<table class="horaires w-full text-[1rem]">
  <caption class="sr-only">Horaires d'ouverture de MON AUTO</caption>
  <tbody>
    {HORAIRES.map((h) => (
      <tr data-jour={h.jour}>
        <th scope="row" class="text-left font-semibold py-2.5 pl-3">{h.nom}</th>
        <td class="text-right py-2.5 pr-3 font-titre font-semibold tabular-nums">{fmtHeure(h.ouvre)} – {fmtHeure(h.ferme)}</td>
      </tr>
    ))}
  </tbody>
</table>
<style>
  .horaires tr { border-bottom: 1px solid var(--color-regle); }
  .horaires tr[aria-current='date'] { background: var(--color-encre); color: var(--color-papier); }
  .horaires tr[aria-current='date'] th::after { content: ' · aujourd’hui'; font-weight: 400; }
</style>
